# Local use (node server.js)
PORT=3000

# Optional. Signs login sessions. If empty, a random key is created and kept in the database.
JWT_SECRET=

# Password given to the sample accounts when an empty database is first filled (and on Reset Sample Data).
# Default is demo1234. Set this before your first public deployment.
SEED_PASSWORD=

# Turso (hosted SQLite) - used on Vercel. Added automatically when you connect Turso in Vercel > Storage.
# Leave empty to use the local protowiz.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
